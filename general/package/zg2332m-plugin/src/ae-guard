#!/bin/sh
# ae-guard — maintient le profil AE du plugin zg2332m.
#
# Majestic reapplique ses propres attributs d'exposition a chaque rechargement
# de configuration (bascule jour/nuit, /api/v1/config/set, ...). Le plafond de
# gain analogique saute alors a 15872, valeur pour laquelle le driver SC2235P
# ecrit 0xff dans le registre capteur 0x3301 : l'image se remplit de traits
# verticaux. Ce garde-fou detecte la derive et reapplique le profil.

CONF=/etc/majestic-ae.conf
PORT=4000
INTERVAL="${INTERVAL:-6}"
REGCHECK_EVERY=5      # sonde le registre capteur 1 passe sur 5
SENSOR_ADDR=0x30

# Valeur d'une cle de la section [AE_Plugin] du fichier de conf.
conf_key() {
	awk -v key="$1" '
		/^[ \t]*\[/ { sec = $0; next }
		sec == "[AE_Plugin]" && tolower($0) ~ "^[ \t]*" tolower(key) "[ \t]*=" {
			sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t;].*$/, ""); print; exit
		}
	' "$CONF" 2>/dev/null
}

live_again() {
	echo gainmax | nc -w 3 localhost $PORT 2>/dev/null |
		sed -n 's/.*AGain\[[0-9]*\.\.\([0-9]*\)\].*/\1/p'
}

live_drc_en() {
	echo drc | nc -w 3 localhost $PORT 2>/dev/null |
		sed -n 's/^drc en=\([0-9]*\).*/\1/p'
}

reg3301() {
	i2ctransfer -y -f 0 w2@$SENSOR_ADDR 0x33 0x01 r1 2>/dev/null
}

# Saturation pilotee par la position du filtre IR-cut.
#
# Le plugin sait deja couper la chroma au-dessus d'un ISO (SatZeroISO), mais
# l'ISO est un mauvais indicateur quand l'illuminateur IR est efficace : une
# camera d'interieur bien eclairee en IR tourne a ISO 600-1400, tres en dessous
# du seuil, alors que son IR-cut est ouvert et que la couleur qu'elle produit
# est fausse (dominante rose, chroma mesuree a 44-51 contre 3 en plein jour).
#
# Le capteur de lumiere, lui, donne directement l'etat : 1 = nuit, IR-cut
# ouvert, chroma sans signification. On s'en sert quand il existe ; sur les
# cameras qui n'en exposent pas (lightMonitor:false), on laisse le repli ISO
# du plugin faire le travail.
#
# Le chemin est re-teste A CHAQUE PASSE, pas une fois au demarrage : majestic
# exporte gpio66 quelques secondes apres son lancement, et S96ae-guard part
# avant. Une sonde unique au demarrage faisait croire au garde-fou, apres tout
# redemarrage, qu'il n'y avait pas de capteur — il cessait alors silencieusement
# de piloter la saturation jusqu'a un redemarrage manuel.
LIGHT_SENSOR=/sys/class/gpio/gpio66/value

# Anti-rebond : le capteur oscille pres du seuil (observe sur une camera
# d'interieur : deux bascules en 7 s). majestic debounce de son cote via
# monitorDelay/dncDelay ; sans equivalent ici, l'image clignoterait entre
# couleur et monochrome. On exige STABLE_N lectures identiques consecutives.
STABLE_N=5

read_night() {
	[ -r "$LIGHT_SENSOR" ] || return 1
	cat "$LIGHT_SENSOR" 2>/dev/null
}

enforce_sat() {           # $1 = 1 (nuit) ou 0 (jour)
	night="$1"
	[ -n "$night" ] || return 0
	live=$(echo sat | nc -w 3 localhost $PORT 2>/dev/null)
	[ -n "$live" ] || return 0
	case "$night" in
	1)
		case "$live" in *"op=manual manual=0 auto"*) return 0 ;; esac
		echo "sat 0" | nc -w 5 localhost $PORT >/dev/null 2>&1
		logger -t ae-guard "nuit (IR-cut ouvert) : saturation forcee a 0"
		;;
	0)
		case "$live" in *"op=auto"*) return 0 ;; esac
		echo "sat auto" | nc -w 5 localhost $PORT >/dev/null 2>&1
		logger -t ae-guard "jour : saturation rendue a l automatique"
		;;
	esac
}

WANT="$(conf_key MaxAGain)"
[ -n "$WANT" ] || WANT=15360

# Majestic remet aussi le DRC a zero en rechargeant sa config. La conf dit ce
# qu'on attend : absente -> on ne surveille pas, "off" -> desactive, sinon
# actif.
WANT_DRC=""
case "$(conf_key DRC)" in
	"")    WANT_DRC="" ;;
	off)   WANT_DRC=0 ;;
	*)     WANT_DRC=1 ;;
esac

logger -t ae-guard "start: cible MaxAGain=$WANT DRC=${WANT_DRC:-libre} capteur_lum=$LIGHT_SENSOR (sonde a chaque passe), intervalle ${INTERVAL}s"

NIGHT_STATE=""      # etat retenu, apres anti-rebond
CAND=""; CAND_N=0   # candidat en cours de confirmation
N=0
while : ; do
	sleep "$INTERVAL"
	N=$((N + 1))
	# Saturation : anti-rebond sur le capteur, puis application. Une passe
	# sur 10 en filet, car une reapplication de profil remet la table auto
	# en service et annulerait le monochrome de nuit.
	if RAW="$(read_night)"; then
		if [ "$RAW" = "$CAND" ]; then
			CAND_N=$((CAND_N + 1))
		else
			CAND="$RAW"; CAND_N=1
		fi
		if [ "$CAND_N" -ge "$STABLE_N" ] && [ "$CAND" != "$NIGHT_STATE" ]; then
			NIGHT_STATE="$CAND"
			enforce_sat "$NIGHT_STATE"
		elif [ -n "$NIGHT_STATE" ] && [ $((N % 10)) -eq 0 ]; then
			enforce_sat "$NIGHT_STATE"
		fi
	fi

	LIVE="$(live_again)"
	[ -n "$LIVE" ] || continue          # majestic absent / plugin pas encore charge

	REASON=""
	[ "$LIVE" != "$WANT" ] && REASON="MaxAGain=$LIVE (attendu $WANT)"
	if [ -z "$REASON" ] && [ -n "$WANT_DRC" ]; then
		DRC_EN="$(live_drc_en)"
		[ -n "$DRC_EN" ] && [ "$DRC_EN" != "$WANT_DRC" ] &&
			REASON="DRC en=$DRC_EN (attendu $WANT_DRC)"
	fi
	if [ -z "$REASON" ] && [ $((N % REGCHECK_EVERY)) -eq 0 ] && [ "$(reg3301)" = "0xff" ]; then
		REASON="registre capteur 0x3301=0xff (traits verticaux)"
	fi
	[ -n "$REASON" ] || continue

	echo "profile current" | nc -w 5 localhost $PORT >/dev/null 2>&1
	sleep 3
	enforce_sat "$NIGHT_STATE"           # le profil vient de rearmer la table auto
	logger -t ae-guard "profil reapplique — $REASON ; MaxAGain=$(live_again) DRC=$(live_drc_en) 0x3301=$(reg3301)"
done
